{
  "name": "agent-academy",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib convex desktop/src scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:compile": "node scripts/desktop-compile.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:start": "electron desktop",
    "desktop:package:dir": "electron-builder --config desktop/builder.config.cjs --win --dir --publish never",
    "desktop:package:win": "electron-builder --config desktop/builder.config.cjs --win nsis --publish never",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:typecheck": "tsc --noEmit -p desktop/tsconfig.json",
    "sync:wiki-abilities": "node scripts/sync-valorant-wiki-abilities.ts",
    "sync:maps": "node scripts/sync-valorant-maps.ts",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "check:unused": "knip",
    "sync:wallpapers": "node scripts/download-playvalorant-wallpapers.ts",
    "format:check": "prettier --check app components lib convex desktop scripts tests docs *.json *.mjs *.mts *.ts README.md",
    "desktop:qa": "node scripts/desktop-qa.mjs",
    "desktop:qa:scroll": "node scripts/scroll-qa.mjs",
    "desktop:release": "node scripts/desktop-build.mjs --production && electron-builder --config desktop/builder.config.cjs --win nsis --publish never"
  },
  "dependencies": {
    "@clerk/electron": "0.1.1",
    "@clerk/react": "6.17.8",
    "@next/env": "16.4.2",
    "@radix-ui/react-select": "2.4.1",
    "convex": "1.47.0",
    "convex-firecrawl-scrape": "0.1.3",
    "electron-store": "8.2.0",
    "electron-updater": "6.8.9",
    "framer-motion": "14.3.0",
    "jose": "6.2.12",
    "lenis": "1.3.27",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "convex-test": "0.0.62",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "knip": "6.42.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
