{
  "name": "agent-academy",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib convex desktop/src scripts/desktop-*.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:compile": "node scripts/desktop-compile.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:start": "electron desktop",
    "desktop:package:dir": "electron-builder --config desktop/builder.config.cjs --win --dir --publish never",
    "desktop:package:win": "electron-builder --config desktop/builder.config.cjs --win nsis --publish never",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:typecheck": "tsc --noEmit -p desktop/tsconfig.json",
    "sync:wiki-abilities": "bun run scripts/sync-valorant-wiki-abilities.ts",
    "sync:maps": "bun run scripts/sync-valorant-maps.ts"
  },
  "dependencies": {
    "@clerk/electron": "0.1.1",
    "@clerk/react": "6.17.8",
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/types": "^5.26.0",
    "convex": "1.47.0",
    "electron-store": "8.2.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.39.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "next": "16.4.2",
    "next-sanity": "^12.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-fast-marquee": "^1.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@sanity/vision": "^5.26.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "convex-test": "0.0.62",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "sanity": "^5.26.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
